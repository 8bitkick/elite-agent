@@ -998,6 +1008,10 @@
 static MACHINE_NOINLINE void sheila_write(struct machine *m, uint16_t addr, uint8_t val)
 {
     switch (addr & 0xfffc) {
+    case 0xfee0: case 0xfee4: case 0xfee8: case 0xfeec:
