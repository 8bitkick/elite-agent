     case 0xfe00: case 0xfe04:
         if ((addr & 1) && m->vs && (m->crtc.addr_reg & 0x1f) <= 9) {
             vs_put(m->vs, VS_EV(VS_FRAMING, 0));
@@ -1623,9 +1637,29 @@
     fdc_power_on_reset(&m->fdc);
 }
 
+// With a parasite on the Tube, the two in slices of TUBE_SLICE host cycles: the host, then the parasite up to the same
+// time. An IRQ the parasite raised or dropped on the host is taken up at the host's next cycle (as a late level).
+#ifndef TUBE_SLICE
+#define TUBE_SLICE 8
+#endif
 uint64_t machine_run(struct machine *m, uint64_t until)
 {
-    return cpu6502_run(&m->cpu, until);
+    if (!tube_on) {
+        return cpu6502_run(&m->cpu, until);
+    }
+    uint64_t start = m->cpu.cycles;
+    while (m->cpu.cycles < until) {
+        uint64_t to = m->cpu.cycles + TUBE_SLICE;
+        cpu6502_run(&m->cpu, to < until ? to : until);
+        uint8_t before = tube_host_irq;
+        tube_par_run(m->cpu.cycles);
+        if (tube_host_irq != before) {
+            m->irq_late = 1;
+            machine_schedule(m);
+            cpu6502_set_sync_due(&m->cpu, m->sync_due);
+        }
+    }
+    return m->cpu.cycles - start;
 }
 
